# Machine-local settings for server.py. Copy to .env in this folder (git ignores it) and fill in.
# server.py reads this file itself; ~ and $HOME are expanded.

# Python environment with the SGLang fork (MuxServe-SGLang-Engine, SGLang 0.5.20, Python 3.12,
# torch 2.13), e.g. the .venv that `uv sync` makes in the Muxserve-SGLang branch checkout.
MUXSERVE_ENV=/path/to/sglang-env

# CUDA toolkit for the extensions and FlashInfer (its bin/ goes on PATH).
CUDA_HOME=/usr/local/cuda-13.2

# Optional: the CrossPool checkout, only printed in the "server ready" message.
CROSSPOOL_DIR=/path/to/CrossPool
