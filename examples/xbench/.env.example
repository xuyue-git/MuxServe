# Machine-local settings for server.py. Copy to .env in this folder (git ignores it) and fill in.
# server.py reads this file itself; ~ and $HOME are expanded.

# The original's own Python environment: Python 3.9 with MuxServe-vLLM and this repository
# installed (root README, Installation).
MUXSERVE_ENV=/path/to/venv

# CUDA toolkit the original was built with (CUDA_HOME and LD_LIBRARY_PATH point here).
CUDA_HOME=/usr/local/cuda-11.8
