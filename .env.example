# Copy to .env (git-ignored) and load it in every terminal before `uv run`:
#   export UV_ENV_FILE="$PWD/.env"
# as CrossPool does. Paths are relative to the repository root.
MUXSERVE_LOCAL_CONFIG=configs/muxserve.local.toml
# GPUs are chosen on the launch command line, not here:
#   CUDA_VISIBLE_DEVICES=1,2,3,4 uv run muxserve serve CONFIG.toml
